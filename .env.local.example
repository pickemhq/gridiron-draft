# Get these from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never exposed to the browser.
# Used by API routes / Edge Functions for autopick + emails.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (or your email provider) for "it's your turn to draft" emails
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Gridiron Draft <draft@yourdomain.com>"

# Optional: College Football Data API (free tier) for real team stats/rankings
# https://collegefootballdata.com
CFBD_API_KEY=your-cfbd-api-key

# Used to build links inside emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
